#!/usr/bin/env bash
# rust-dev-stack-report — runs rust-dev's scripts/stack-report.sh with the same arguments.
# Resolves its own real path by following symlinks with plain readlink,
# since readlink -f is missing on older macOS.
set -eu
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
dir="$(cd -P "$(dirname "$src")/../scripts" && pwd)"
exec bash "$dir/stack-report.sh" "$@"
